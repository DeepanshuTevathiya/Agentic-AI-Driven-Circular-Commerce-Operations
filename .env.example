# ==============================================================================
# Demand Consumption Pipeline - Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Runtime environment (development, staging, production)
PIPELINE_ENV=production

# Logging level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# REST API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
MAX_WORKERS=4

# Security and Operator Authorization
# Set a strong, cryptographically secure key in production environments
OPERATOR_API_KEY=agy-secret-lead2-key

# Comma-separated list of authorized operator usernames for governance actions (e.g. PO approval)
AUTHORIZED_OPERATORS=admin,ops_lead,lead2_supervisor

# Persistent SQLite Database Locations (relative to project root or absolute paths)
COORDINATOR_DB_PATH=data/coordinator/coordinator.db
FULFILMENT_DB_PATH=data/fulfilment/fulfilment.db

# Machine Learning Artifacts and Historical Datasets
DATASET_PATH=data/processed/df_featured.parquet
MODELS_DIR=outputs

